# Copy this file to .env in the backend folder and fill in local values.
# Never commit a real .env file or API key.

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000

# Required for Live AI Trainer real-time voice conversations and AI coaching.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

DATABASE_URL=sqlite:///open_talk.db
